num = 1
if num==1:  #Since 1 is neither prime nor composite by mathematical definition, this line directly prints "not a prime" when num is 1.
    print("not a prime")

if num > 1:
    for i in range(2, num): #This checks every number from 2 up to num - 1
        if num % i == 0:
            print("not a prime")
            break
    else:
            print("prime")    
           


