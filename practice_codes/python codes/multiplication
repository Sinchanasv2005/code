# tables reverse oder
for i in range(2,3):
    for j in range(10,0,-1): #10 means start from 10,0 is the stop before 0,-1 reverse order
        print(f"{i}*{j}={i*j}")
# output
2*10=20
2*9=18
2*8=16
2*7=14
2*6=12
2*5=10
2*4=8
2*3=6
2*2=4
2*1=2
    

